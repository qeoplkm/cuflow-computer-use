          "description": "Member Number to look up",
          "pattern": "^\\d{5}$"
        }
      },
      "required": [
        "member_id"
      ],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "savings_balance": {
          "type": "string",
          "description": "Current Share Savings balance (money)"
        }
      }
    },
    "requires_approval": false
  }
