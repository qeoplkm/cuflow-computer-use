# Copy to .env (git-ignored). The CLI loads it automatically.

# LLM for discovery runs (only discovery needs a model; replay never calls one)
GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=

# Password the local MockCore mock app accepts (mock credential for a mock app)
MOCKCORE_PASSWORD=demo-teller-pass

# Tenant secret store (env: scheme). Referenced by catalog/tenants/*.yaml, never stored in artifacts.
CUFLOW_SECRET_HARBOR_OPERATOR_USERNAME=teller01
CUFLOW_SECRET_HARBOR_OPERATOR_PASSWORD=demo-teller-pass
CUFLOW_SECRET_SUMMIT_OPERATOR_USERNAME=teller01
CUFLOW_SECRET_SUMMIT_OPERATOR_PASSWORD=demo-teller-pass
