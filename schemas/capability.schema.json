    "Step": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "stable id; logs, drift reports and tenant overrides key off it",
          "title": "Id",
          "type": "string"
        },
        "intent": {
          "description": "why this step exists, for reviewers",
          "title": "Intent",
          "type": "string"
        },
        "action": {
          "discriminator": {
            "mapping": {
              "click": "#/$defs/ClickAction",
              "extract": "#/$defs/ExtractAction",
              "fill": "#/$defs/FillAction",
              "navigate": "#/$defs/NavigateAction",
              "press": "#/$defs/PressAction",
              "select": "#/$defs/SelectAction"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ClickAction"
            },
            {
              "$ref": "#/$defs/FillAction"
            },
            {
              "$ref": "#/$defs/SelectAction"
            },
            {
              "$ref": "#/$defs/PressAction"
            },
            {
              "$ref": "#/$defs/NavigateAction"
            },
            {
              "$ref": "#/$defs/ExtractAction"
            }
          ],
          "title": "Action"
        },
        "risk": {
          "$ref": "#/$defs/Risk",
          "default": "safe"
        },
        "idempotent": {
          "default": true,
          "description": "safe to repeat if the flow must restart",
          "title": "Idempotent",
          "type": "boolean"
        },
        "expect": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "all": "#/$defs/AllCondition",
                  "any": "#/$defs/AnyCondition",
                  "dialog": "#/$defs/DialogCondition",
                  "element": "#/$defs/ElementCondition",
                  "location": "#/$defs/LocationCondition",
                  "not": "#/$defs/NotCondition",
                  "text": "#/$defs/TextCondition"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TextCondition"
                },
                {
                  "$ref": "#/$defs/ElementCondition"
                },
                {
                  "$ref": "#/$defs/LocationCondition"
                },
                {
                  "$ref": "#/$defs/DialogCondition"
                },
                {
                  "$ref": "#/$defs/AllCondition"
                },
                {
                  "$ref": "#/$defs/AnyCondition"
                },
                {
                  "$ref": "#/$defs/NotCondition"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "postcondition to wait for (we never sleep)",
          "title": "Expect"
        },
        "timeout_ms": {
          "default": 15000,
          "title": "Timeout Ms",
          "type": "integer"
        },
        "actor": {
          "default": "agent",
